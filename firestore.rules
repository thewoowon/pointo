rules_version = '2';

// 포인토 Firestore 보안 규칙
//
// 위협 모델 — 무엇을 막는가:
//   1) [최우선] 고객 전화번호 대량 유출. users 문서 ID가 전화번호이고 logs에도
//      phone_number가 들어있다. 이전 규칙(allow read, write: if true)에서는
//      누구든 컬렉션 전체를 덤프할 수 있었다. 웹으로 확장하면 브라우저 콘솔
//      한 줄이면 되는 수준이라 여기부터 닫는다.
//   2) 남의 매장 데이터 접근. 점주는 자기 계정에 연결된 매장만 다룰 수 있다.
//   3) 서버 전용 컬렉션(ownerTokens) 노출.
//
// 무엇을 아직 못 막는가 (다음 단계):
//   - 키오스크는 익명 세션이라 "누구나 받을 수 있는" 신원이다. 즉 전화번호를
//     이미 아는 공격자가 그 사람의 스탬프를 단건 조회·조작하는 것은 아직 가능하다.
//     대량 열거는 막았지만 위조는 못 막는다. → App Check(기기 증명) 도입,
//     이후 적립/사용 쓰기를 Callable Function으로 이전하면 닫힌다.
//
// ⚠️ 배포 전 필독: 이 규칙은 Firebase Auth 세션을 전제로 한다. Firebase Auth가
//    없는 구버전 앱은 이 규칙이 켜지는 즉시 전부 동작을 멈춘다.
//    반드시 모든 매장 기기를 신버전으로 올린 뒤 배포할 것. (SECURITY_PASS.md 참고)

service cloud.firestore {
  match /databases/{database}/documents {

    // ─── 헬퍼 ──────────────────────────────────────────────────────────

    function isSignedIn() {
      return request.auth != null;
    }

    /** 익명(키오스크) 세션이 아닌 실제 소셜 로그인 점주 */
    function isOwner() {
      return isSignedIn()
        && request.auth.token.firebase.sign_in_provider != 'anonymous';
    }

    /**
     * 주어진 값이 내 토큰에 실린 소셜 제공자 id인지.
     *
     * Firebase Auth 도입 전에는 owners 문서와 stores.ownerId를 구글/애플 제공자
     * id로 키잉했다. 그 문서들을 새 Firebase uid로 이전하려면 레거시 id에 한 번은
     * 접근해야 하는데, ID 토큰의 identities에 그 id가 실제로 들어있을 때만 허용하면
     * 남의 계정을 건드릴 수는 없다. 마이그레이션이 끝나면 이 함수는 제거해도 된다.
     */
    function ownsProviderId(id) {
      let identities = request.auth.token.firebase.identities;
      return isOwner() && id is string && (
        ('google.com' in identities && identities['google.com'].hasAny([id]))
        || ('apple.com' in identities && identities['apple.com'].hasAny([id]))
      );
    }

    function ownerPath() {
      return /databases/$(database)/documents/owners/$(request.auth.uid);
    }

    /** 내 계정에 연결된 매장인지 */
    function ownsStore(code) {
      return isOwner()
        && code is string
        && exists(ownerPath())
        && get(ownerPath()).data.storeCodes.hasAny([code]);
    }

    /** 쓰기 후 문서의 매장 코드 (생성·수정 공통) */
    function incomingStore() {
      return request.resource.data.store_code;
    }

    /**
     * 적립 진행도를 통째로 날리는 쓰기를 거부한다.
     *
     * 적립·사용 핸들러는 로컬 `user` 상태로 새 값을 계산해 문서를 덮어쓰는데,
     * 그 초기값이 blankUser(level 0, coupons {})다. 문서를 읽어오기 전에 점주가
     * 적립을 누르면 blankUser가 그대로 저장돼 쿠폰과 레벨이 사라진다.
     * (KB000001에서 54명이 이렇게 날아갔다)
     *
     * 앱은 guardLoaded로 고쳤지만 **배포되기 전까지, 그리고 업데이트를 미루는
     * 매장 기기에서는 계속 발생한다.** 여기서 막으면 버전과 무관하게 즉시 멈춘다.
     *
     * 정상 쓰기와 구분되는 두 가지 불변식만 본다:
     *   1) level은 코드 어디에서도 감소하지 않는다 (`level += 1`만 존재)
     *   2) 쿠폰을 다 써도 맵은 비지 않는다 — removeCouponEntries는 키를 남겨
     *      `{coupon_a: 0}`이 되지 `{}`가 되지 않는다. 정확히 `{}`인 쓰기는
     *      blankUser뿐이다.
     *
     * 두 필드를 건드리지 않는 쓰기(세션·약관 등)는 그대로 통과한다.
     */
    function keepsProgress() {
      return (
        !('level' in request.resource.data)
        || request.resource.data.level >= resource.data.get('level', 0)
      ) && (
        !('coupons' in request.resource.data)
        || request.resource.data.coupons.keys().size() > 0
        || resource.data.get('coupons', {}).keys().size() == 0
      );
    }

    // ─── owners — 점주 계정 ────────────────────────────────────────────
    // 본인 문서만. 계정 열거(list)는 전면 금지.
    match /owners/{uid} {
      allow get: if isOwner()
        && (request.auth.uid == uid || ownsProviderId(uid));
      allow create: if isOwner() && request.auth.uid == uid;
      allow update: if isOwner()
        && (request.auth.uid == uid || ownsProviderId(uid));
      allow delete: if false;   // 탈퇴는 soft delete만 — 실삭제는 서버 스케줄러
      allow list: if false;
    }

    // ─── stores — 매장 ────────────────────────────────────────────────
    match /stores/{code} {
      // 키오스크가 매장 설정(config, 이름)을 읽어야 하므로 단건 조회는 인증만 요구.
      // 코드를 알아야 읽을 수 있고 열거는 아래에서 막으므로 대량 수집은 불가능.
      allow get: if isSignedIn();

      // ⭐ 목록 조회 전면 금지.
      // 예전에는 점주 온보딩(전화번호로 기존 매장 찾기)을 위해 점주에게 열어뒀다.
      // 그런데 규칙은 쿼리의 where 조건을 검사할 수 없어서 "내 번호로 한 건 찾기"와
      // "전 매장 덤프"를 구별하지 못한다. 즉 점주 계정 하나만 만들면 모든 매장의
      // 코드·이름·점주 연락처를 긁을 수 있었다.
      // 계정에 연결된 매장은 owners.storeCodes로 단건 조회한다(getOwnerStores).
      allow list: if false;

      // 생성 시점에 주인을 못 박는다. "주인 없는 매장"이라는 상태 자체를
      // 만들지 않는 것이 아래 update 규칙의 전제다.
      allow create: if isOwner()
        && request.resource.data.ownerId == request.auth.uid;

      // 쓰기가 가능한 경우:
      //   - 이미 내 매장
      //   - 주인이 내 레거시 제공자 id인 매장 (uid 마이그레이션)
      //
      // ⚠️ 예전에는 "주인이 없으면 누구나"(ownerId == null)를 허용했다. 그게
      //    점주 연락처만 알면 남의 매장을 통째로 가져갈 수 있는 구멍이었고,
      //    매장을 쥐면 그 매장 고객 전화번호 전량까지 열렸다(ownsStore).
      //    주인 없는 레거시 매장은 이제 서버(Admin SDK)에서만 연결한다.
      allow update: if isOwner() && (
        resource.data.get('ownerId', null) == request.auth.uid
        || ownsProviderId(resource.data.get('ownerId', null))
      );

      allow delete: if false;
    }

    // ─── users — 고객 (문서 ID = 전화번호[_매장코드]) ──────────────────
    match /users/{docId} {
      // 키오스크가 방금 입력한 번호 한 건을 조회한다. 익명 세션 허용.
      allow get: if isSignedIn();

      // ⭐ 핵심 방어선: 목록 조회는 자기 매장을 가진 점주만.
      // 쿼리가 반환하는 문서 하나하나에 대해 평가되므로, store_code 필터가 없는
      // 전체 스캔은 여기서 반드시 실패한다.
      allow list: if ownsStore(resource.data.get('store_code', null));

      allow create: if isSignedIn() && incomingStore() is string;

      allow update: if isSignedIn()
        && (
          // 매장 코드는 바꿀 수 없다 (다른 매장으로 문서를 옮기는 것 방지)
          !('store_code' in request.resource.data)
          || incomingStore() == resource.data.get('store_code', incomingStore())
        )
        && keepsProgress();

      // 고객 탈퇴(키오스크) 또는 점주의 고객 삭제
      allow delete: if isSignedIn();
    }

    // ─── terms — 약관 동의 (users와 같은 문서 ID) ─────────────────────
    match /terms/{docId} {
      allow get, create, update, delete: if isSignedIn();
      allow list: if false;
    }

    // ─── logs — 적립/사용 이력 (phone_number 포함) ────────────────────
    match /logs/{logId} {
      // ⭐ 조회는 전부 점주 한정. 익명에 열면 매장 전체 전화번호가 새어나간다.
      // 고객 탈퇴 시의 이력 정리는 클라이언트가 아니라 서버(onUserDeleted)가 한다.
      allow get, list: if ownsStore(resource.data.get('store_code', null));

      // 키오스크가 적립/사용 로그를 남긴다. 매장 코드는 필수.
      allow create: if isSignedIn() && incomingStore() is string;

      allow update: if false;   // 이력은 불변
      allow delete: if ownsStore(resource.data.get('store_code', null));
    }

    // ─── sessions — 키오스크↔점주 실시간 페어링 (session_{매장코드}) ──
    // PII가 없고 수명이 짧다. 목록 조회만 막아 매장 열거를 차단한다.
    match /sessions/{sessionId} {
      allow get, create, update: if isSignedIn();
      allow list, delete: if false;
    }

    // ─── ratings — 현재 미사용. 향후 대비로 인증 사용자에게만 개방 ────
    match /ratings/{docId} {
      allow get, create, update: if isSignedIn();
      allow list, delete: if false;
    }

    // ─── feedback — 점주 의견 보내기 ──────────────────────────────────
    // 쓰기 전용이다. 남의 의견을 읽을 이유가 없고 본문에 매장 사정이 그대로
    // 담기므로 조회는 전면 차단하고 콘솔/Admin SDK로만 본다.
    // 익명(키오스크) 세션은 제외한다 — 손님이 쓰는 화면에는 이 입구가 없고,
    // 열어두면 아무나 무제한으로 문서를 만들 수 있다.
    match /feedback/{docId} {
      allow create: if isOwner()
        && request.resource.data.ownerUid == request.auth.uid
        && request.resource.data.text is string
        && request.resource.data.text.size() > 0
        && request.resource.data.text.size() <= 2000;
      allow read, update, delete: if false;
    }

    // ─── ownerTokens — 서버 전용 (Apple refresh token) ────────────────
    // Functions는 Admin SDK라 규칙을 우회한다. 클라이언트는 전면 차단.
    match /ownerTokens/{uid} {
      allow read, write: if false;
    }

    // 그 외 모든 경로: 기본 거부
  }
}
